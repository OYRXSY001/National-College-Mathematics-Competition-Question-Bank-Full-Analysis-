DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 桌面版（run_bank.py / exe）启动相关；一般无需改动
# BANK_DATA_DIR=<题库数据目录，默认 exe/脚本所在目录>
# BANK_PORT=8000
# 生产部署请务必:(1) DJANGO_DEBUG=0；(2) 使用长随机值替换 SECRET_KEY
# Caddy 反代部署时声明可信代理，否则伪造 X-Forwarded-For 可绕过 admin 白名单/限流：
# DJANGO_TRUSTED_PROXIES=127.0.0.1
# 管理后台可选 IP 白名单（配合 TRUSTED_PROXIES 使用）：
# DJANGO_ADMIN_ALLOWED_IPS=1.2.3.4
